#include <stdbool.h>
#include <stdio.h>

#include "adas_overlay.h"

// 오버레이가 기준으로 사용하는 화면 해상도
#define ADAS_SCREEN_WIDTH  1920.0f
#define ADAS_SCREEN_HEIGHT 1080.0f

// 검출 bbox의 하단 위치를 기준으로 위험 단계를 나누는 임계값
#define ADAS_WARNING_BOTTOM_RATIO 0.55f
#define ADAS_DANGER_BOTTOM_RATIO  0.78f

// SAFE, WARNING, DANGER 순서의 화면 표시 색상
static float risk_color[3][4] = {
    {0.10f, 0.85f, 0.20f, 0.90f},
    {1.00f, 0.70f, 0.05f, 0.90f},
    {0.95f, 0.10f, 0.08f, 0.90f}
};

static const char *risk_name(RiskLevel level)
{
    // enum 위험 단계를 화면에 표시할 문자열로 변환
    switch (level) {
    case RISK_WARNING:
        return "WARNING";
    case RISK_DANGER:
        return "DANGER";
    case RISK_SAFE:
    default:
        return "SAFE";
    }
}

static void draw_risk_zone(struct gl_npu_program npu_prog)
{
    // 화면 하단의 위험 구역을 사각형 형태의 안내선으로 표시
    float zone_color[4] = {1.00f, 0.70f, 0.05f, 0.85f};

    nc_opengl_draw_line(760.0f, 620.0f, 1160.0f, 620.0f, 1, zone_color, npu_prog);
    nc_opengl_draw_line(760.0f, 620.0f, 430.0f, 1070.0f, 1, zone_color, npu_prog);
    nc_opengl_draw_line(1160.0f, 620.0f, 1490.0f, 1070.0f, 1, zone_color, npu_prog);
    nc_opengl_draw_line(430.0f, 1070.0f, 1490.0f, 1070.0f, 1, zone_color, npu_prog);
}

// 현재 프레임에서 계산된 위험 단계와 검출 여부
static RiskLevel current_risk_level = RISK_SAFE;
static bool has_detection = false;

void adas_begin_risk_frame(void)
{
    // 프레임마다 이전 프레임의 위험 상태가 남지 않도록 초기화
    current_risk_level = RISK_SAFE;
    has_detection = false;
}

void adas_update_risk_from_bottom(float normalized_bottom_y)
{
    // 하나 이상의 객체가 검출되었음을 기록
    has_detection = true;

    // 위험 단계는 SAFE -> WARNING -> DANGER 순서로 높아질 수 있음
    if (normalized_bottom_y >= ADAS_DANGER_BOTTOM_RATIO) {
        current_risk_level = RISK_DANGER;
    } else if (normalized_bottom_y >= ADAS_WARNING_BOTTOM_RATIO &&
               current_risk_level < RISK_WARNING) {
        current_risk_level = RISK_WARNING;
    }
}

RiskLevel adas_get_risk_level(void)
{
    // 현재 프레임에 검출 객체가 없으면 안전 상태로 처리
    if (!has_detection) {
        return RISK_SAFE;
    }

    return current_risk_level;
}

void adas_draw_overlay(const RiskResult *result,
                       struct gl_npu_program npu_prog,
                       Font *font,
                       struct gl_font_program font_prog)
{
    // 화면에 표시할 상태 문자열과 색상을 준비
    char status_text[64];
    float text_color[3];
    RiskLevel level = RISK_SAFE;
    float fps = 0.0f;
    float latency_ms = 0.0f;

    if (result != NULL) {
        // 호출부가 전달한 현재 프레임의 위험도와 성능 정보를 사용
        level = result->level;
        fps = result->fps;
        latency_ms = result->latency_ms;
    }
    if (level < RISK_SAFE || level > RISK_DANGER) {
        // 잘못된 enum 값이 들어오면 안전 상태로 보정
        level = RISK_SAFE;
    }

    // 영상 위에 위험 구역 안내선을 먼저 그림
    draw_risk_zone(npu_prog);

    text_color[0] = risk_color[level][0];
    text_color[1] = risk_color[level][1];
    text_color[2] = risk_color[level][2];

    // 위험 단계와 성능 정보를 화면 왼쪽 아래에 표시
    snprintf(status_text, sizeof(status_text), "RISK %s", risk_name(level));
    nc_opengl_draw_text(font, status_text, 40.0f, 1000.0f, 1.0f,
                        text_color, (int)ADAS_SCREEN_WIDTH,
                        (int)ADAS_SCREEN_HEIGHT, font_prog);

    snprintf(status_text, sizeof(status_text), "FPS %.1f  NPU %.1f ms",
             fps, latency_ms);
    nc_opengl_draw_text(font, status_text, 40.0f, 1040.0f, 0.75f,
                        text_color, (int)ADAS_SCREEN_WIDTH,
                        (int)ADAS_SCREEN_HEIGHT, font_prog);
}
